# Track maintained distribution sources and a small, portable release toolchain.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/README.md
!/QFXAddonManager/
!/QFXAddonManager_Config/
!/QFXAddonManager_Toolbox_Daily/
!/QFXAddonManager_Toolbox_Combat/
!/QFXAddonManager_Toolbox_ChatBar/
!/QFXAddonManager_Libraries_GlowFallback/
!/QFX_SharedMedia/
!/tools/
/tools/*
!/tools/build_addon.py
!/tools/release.py
!/tools/audit_localization.py
!/tools/locale_deadkey_report.py
!/tools/validate_ui.lua
!/tools/validate_addon_title_language.lua
!/tools/validate_class_card_picker.lua
!/tools/validate_forever_compat.lua
!/tools/validate_forever_toolbox.lua
!/tests/
!/docs/
/docs/*
!/docs/AUTO_RELEASE.md
!/docs/PACKAGE_LAYOUT.md
!/docs/SHARED_MEDIA.md
!/docs/ENGLISH_UI_LABELS.md
!/docs/FOREVER_COMPAT.md
!/docs/RELEASE_*.md

**/__pycache__/
*.pyc
*.bak
*.log
*.zip
.env
.env.*
**/node_modules/
**/PID-*
**/addon_version.txt

